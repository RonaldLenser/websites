# Copy to .env.local for local dev. Set the same keys in Vercel > Project > Settings > Environment Variables.

# ---- GoHighLevel (Helix Research Technologies sub-account) ----
# Private Integration token with contacts.write, opportunities.write, opportunities.readonly scopes.
GHL_API_KEY=
GHL_LOCATION_ID=nY3N805cUKCkB3TuYsN0
# Marketing Pipeline. Every website lead opens a deal here, in the stage named GHL_STAGE_NAME.
GHL_PIPELINE_ID=RSK8qMC9fN6AS5IR193P
GHL_STAGE_NAME=New
# Optional custom field ids so need/budget/message land in named fields, not only tags.
GHL_FIELD_NEED_ID=
GHL_FIELD_BUDGET_ID=
GHL_FIELD_MESSAGE_ID=

# ---- Discord ----
# Channel webhook (channel settings > Integrations > Webhooks). Every lead posts here instantly with the full form.
# The Helix bot also posts the GHL contact and deal on its own within a minute.
DISCORD_LEAD_WEBHOOK_URL=
# Preferred: post as the "Helix Website" bot user instead (profile with avatar, banner, bio).
# Create the app at discord.com/developers, add the bot to the server with Send Messages, paste its token here.
DISCORD_BOT_TOKEN=
DISCORD_LEAD_CHANNEL_ID=1551772822685356132

# ---- Email copy via Resend (optional) ----
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@helixresearchtech.com
LEAD_FROM_EMAIL=Helix Website <leads@helixresearchtech.com>

# ---- CORS ----
# Origins allowed to POST to /api/lead from another host (the GitHub Pages preview).
ALLOWED_ORIGINS=https://ronlenserdigital.github.io
# Public origin used for absolute asset links in Discord embeds (avatar, banner).
NEXT_PUBLIC_SITE_ORIGIN=https://helixresearchtech.com

# ---- Public ----
# GHL calendar embed shown on /contact. Example: https://api.leadconnectorhq.com/widget/booking/XXXXXXXX
NEXT_PUBLIC_GHL_CALENDAR_URL=
# Google Tag Manager container id (GTM-XXXXXXX). Blank disables it.
NEXT_PUBLIC_GTM_ID=
# Google Search Console HTML tag verification token (the content= value). Blank disables it.
NEXT_PUBLIC_GSC_VERIFICATION=

# ---- Static export only (GitHub Pages workflow sets these) ----
# STATIC_EXPORT=1  BASE_PATH=/helix-website  LEAD_ENDPOINT=https://helixresearchtech.com/api/lead
